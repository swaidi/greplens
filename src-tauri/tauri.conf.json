{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrepLens",
  "version": "0.1.4",
  "identifier": "io.github.swaidi.greplens",
  "build": {
    "frontendDist": "./shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GrepLens",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "A.T.Grep",
    "copyright": "AGPL-3.0",
    "category": "Productivity",
    "shortDescription": "Offline document review with local AI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/greplens-backend"
    ],
    "resources": {
      "resources/engine/": "engine/",
      "resources/tessdata/": "tessdata/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Arabic"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
